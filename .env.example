# Public site URL (no trailing slash). Used for Stripe success/cancel redirects.
PUBLIC_SITE_URL=http://localhost:5173

# Stripe — use the same account as Grove if you want, but create NEW CHUNK products
# (do not reuse Grove Plus price IDs). Run: npm run stripe:setup
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHUNK_PRICE_ID=

# Optional: list price created by setup script (not charged at launch).
# STRIPE_CHUNK_LIST_PRICE_ID=

# Hidden admin (footer VST “T”). Local only — leave unset on Vercel.
# Set to true in .env.local to enable the secret door + /admin.html
ENABLE_ADMIN=
ADMIN_PASSWORD=

# Supabase (assemblydsp project) — service role only on the server
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# HMAC secret for cached plugin license tokens (long random string)
LICENSE_TOKEN_SECRET=

# Optional: paste after generating with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# CHUNK build URL (Supabase public zip). Overrides the default in lib/download.js.
CHUNK_BUILD_URL=https://qtfjgaysjfkipfdiaeyc.supabase.co/storage/v1/object/public/plugin-builds/CHUNK-0.9.42.zip

# Optional separate secret for download tokens (defaults to LICENSE_TOKEN_SECRET)
# CHUNK_DOWNLOAD_SECRET=

# Resend — transactional email (trial / purchase / lost-key recovery).
# ImprovMX handles inbound mail; Resend is send-only.
# Production: set both on the Vercel project (Production env), then redeploy.
RESEND_API_KEY=
# Must be an address on your Resend-verified domain (assemblydsp.com).
EMAIL_FROM=Assembly DSP <support@assemblydsp.com>

